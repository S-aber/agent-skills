# LLM Configuration (local deployment, OpenAI-compatible API)
LLM_API_BASE=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_DEFAULT_MODEL=gpt-4o

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DATABASE_URL=sqlite+aiosqlite:///./agent_skills.db

# Storage
SKILLS_STORAGE_PATH=./storage/skills
WORKSPACE_STORAGE_PATH=./storage/workspace
