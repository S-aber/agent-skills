# LLM Configuration - 智谱 AI (OpenAI-compatible)
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-zhipu-api-key
LLM_DEFAULT_MODEL=glm-4-flash

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DATABASE_URL=sqlite+aiosqlite:///./agent_skills.db

# Storage
SKILLS_STORAGE_PATH=./storage/skills
WORKSPACE_STORAGE_PATH=./storage/workspace

# Logging
LOGS_DIR=./logs
LOG_LEVEL=INFO
